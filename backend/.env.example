# Copy to .env and fill in. Never commit .env.
LLAMA_API_KEY=            # key from your AI provider (Groq by default)
# LLM_BASE_URL=https://api.groq.com/openai/v1   # any OpenAI-compatible API, e.g. https://api.deepinfra.com/v1/openai (pay per use, no daily cap)
# LLM_MODEL=openai/gpt-oss-120b                 # e.g. meta-llama/llama-4-scout on OpenRouter
# ALLOWED_ORIGINS=http://localhost:5173,https://gauravmishraofficial.github.io
# TRIPS_PER_HOUR=10
